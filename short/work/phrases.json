  "end": 12.3,
  "f0": 330,
  "f1": 369,
  "segments": [
   3,
   4
  ]
 },
 {
  "text": "A clock.",
  "start": 12.8,
  "end": 13.43,
  "f0": 384,
  "f1": 403,
  "segments": [
   4,
   5
  ]
 },
