  "end": 56.03,
  "f0": 1613,
  "f1": 1681,
  "segments": [
   23,
   24
  ]
 },
 {
  "text": "You see,",
  "start": 56.53,
  "end": 57.023,
  "f0": 1696,
  "f1": 1711,
  "segments": [
   24,
   25
  ]
 },
 {
  "text": "the thief had never wanted their things.",
