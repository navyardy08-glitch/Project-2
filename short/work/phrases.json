  "end": 61.33,
  "f0": 1788,
  "f1": 1840,
  "segments": [
   25,
   26
  ]
 },
 {
  "text": "He carried it home,",
  "start": 61.78,
  "end": 62.7,
  "f0": 1853,
  "f1": 1881,
  "segments": [
   26,
   27
  ]
 },
 {
  "text": "mended it by candlelight,",
  "start": 63.01,
  "end": 64.26,
  "f0": 1890,
  "f1": 1928,
  "segments": [
   27,
   28
  ]
 },
 {
